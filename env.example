# ~/.hermes/.env — the front desk's keys. The gateway reads this file ONLY at startup:
# after any change, stop the gateway (Ctrl-C) and run `hermes gateway run --replace` again.
# Never commit this file anywhere.

# --- Telegram (step 5) ---
TELEGRAM_BOT_TOKEN=<BOT_TOKEN>                 # the desk bot's token from @BotFather — the only token in this build
TELEGRAM_GROUP_ALLOWED_CHATS=<GROUP_ID>        # your supergroup id, -100… — only this group may reach the desk

# --- Email (step 8) ---
EMAIL_ADDRESS=<DESK_EMAIL>                     # a dedicated mailbox for the desk, never a personal one
EMAIL_PASSWORD=<APP_PASSWORD>                  # the 16-character Gmail App Password (2-Step Verification must be on)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_ALLOWED_USERS=<CUSTOMER_EMAIL>           # REQUIRED while building: only this sender is answered.
# EMAIL_ALLOW_ALL_USERS=true                   # use INSTEAD of the line above for a desk that takes mail from anyone.
# With NEITHER line set the desk answers nobody, silently — deleting the allowlist closes the desk, it does not open it.
